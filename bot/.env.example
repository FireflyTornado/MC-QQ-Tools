# Copy to bot/.env and replace placeholders for enabled settings.
# Process environment variables take precedence over this file.

# Shared settings
# NoneBot connects to NapCat over OneBot WebSocket. Use the same token on both ends.
DRIVER=~websockets
LOG_LEVEL=INFO
ONEBOT_WS_URLS=["ws://127.0.0.1:13001/"]
ONEBOT_ACCESS_TOKEN=REPLACE_WITH_ONEBOT_ACCESS_TOKEN

# Target QQ group for the bot and FastAPI. Replace 0 with the numeric group ID.
TARGET_GROUP_ID=0

# Optional. Add QQ IDs as strings to allow /info and, when authorization is enabled, /reconcile.
SUPERUSERS=[]

# Optional. Set the Minecraft Java server address to show its status in /info (e.g. play.example.org:25565).
MC_STATUS_ADDRESS=

# ---------

# Authorization and notifications
# Defaults to enabled. Set to false for a /sudo-only installation.
MC_AUTH_ENABLED=true

# Use MC_API_TOKEN for the authorization plugin's api.token.
# The bot uses MC_NOTIFY_TOKEN to notify FastAPI. Use distinct tokens.
MC_API_TOKEN=REPLACE_WITH_MC_API_TOKEN
MC_NOTIFY_TOKEN=REPLACE_WITH_MC_NOTIFY_TOKEN

# Set an independent token when enabling Minecraft banlist reporting.
MC_BANLIST_TOKEN=REPLACE_WITH_MC_BANLIST_TOKEN

# Optional. Keep this endpoint on a trusted network.
MC_NOTIFY_URL=http://127.0.0.1:18765/internal/mc/notify

# ---------

# Remote commands (/sudo)
# Set to false to disable /sudo even if the QQ list is configured.
# If the switch is unset, a nonempty QQ list enables /sudo.
MC_SUDO_ENABLED=true
# Add authorized QQ IDs as strings (e.g. ["123456789"]). An empty list keeps /sudo disabled.
MC_SUDO_QQ_IDS=[]

# Set both tokens to distinct values when enabling /sudo. Use different values from the tokens above.
# The bot uses MC_SUDO_BOT_TOKEN to submit commands and read replies.
MC_SUDO_BOT_TOKEN=REPLACE_WITH_MC_SUDO_BOT_TOKEN
# MC_SUDO_MOD_TOKEN matches the MCQQSudo mod's sudo.token.
MC_SUDO_MOD_TOKEN=REPLACE_WITH_MC_SUDO_MOD_TOKEN

# The bot sends UTF-8 TXT when the output body exceeds any threshold.
# Thresholds exclude request IDs and status text. Set the per-line character limit to 0 to disable it.
MC_SUDO_FILE_LINE_THRESHOLD=10
MC_SUDO_FILE_LINE_CHAR_THRESHOLD=0
MC_SUDO_TEXT_MAX_CHARS=1500
